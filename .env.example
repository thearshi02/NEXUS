# ============================================================================
# NEXUS — AI-Powered Financial Trust Passport Environment Variables
# ============================================================================

# Gemini AI API Key (Optional: Server-side AI intelligence analysis)
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Configuration (Optional: Connects to live Supabase PostgreSQL DB)
# When omitted, NEXUS runs in instant local-first offline demo mode with LocalStorage persistence.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Backend Server Port
PORT=3001
